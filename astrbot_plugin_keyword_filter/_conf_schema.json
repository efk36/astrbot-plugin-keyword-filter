{
  "enabled": {
    "description": "启用屏蔽",
    "type": "bool",
    "default": true,
    "hint": "关闭后插件不做任何拦截"
  },
  "block_keywords": {
    "description": "屏蔽词列表",
    "type": "list",
    "default": [],
    "hint": "命中任意一个即拦截。匹配时会忽略大小写、空格和常见分隔符"
  },
  "bypass_user_ids": {
    "description": "豁免 QQ 号列表",
    "type": "list",
    "default": [],
    "hint": "这些 QQ 号不受屏蔽影响。AstrBot 管理员本身已自动豁免"
  },
  "bypass_group_ids": {
    "description": "豁免群号列表",
    "type": "list",
    "default": [],
    "hint": "填了这些群，群里所有人不受屏蔽影响"
  },
  "ignore_separators": {
    "description": "匹配时忽略分隔符",
    "type": "bool",
    "default": true,
    "hint": "开启后，色 情、色-情、色.情 视为同一个词"
  },
  "block_action": {
    "description": "命中后的处理方式",
    "type":"object",
    "items": {
      "stop_event": {
        "description": "终止本次对话",
        "type": "bool",
        "default": true
      },
      "reply": {
        "description": "是否回复提示",
        "type": "bool",
        "default": true
      },
      "reply_text": {
        "description": "提示语",
        "type": "text",
        "default": "这个话题就不聊了，换一个吧。"
      }
    }
  },
  "log_hit": {
    "description": "记录命中日志",
    "type": "bool",
    "default": true,
    "hint": "命中时在 AstrBot 日志里记录发送者和命中的词"
  }
}
